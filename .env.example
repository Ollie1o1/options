# AI ranking layer (ai_rank.py) — free account at openrouter.ai, no card required
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: per-model keys for specialised free-tier models (see README ->
# "The AI Ranking Layer" for the model list). Falls back to OPENROUTER_API_KEY
# if unset.
# OPENROUTER_LING_KEY=sk-or-v1-...      # inclusionai/ling-3.0-flash:free
# OPENROUTER_NVIDIA_KEY=sk-or-v1-...    # nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_POOLSIDE_KEY=sk-or-v1-...  # poolside/laguna-s-2.1:free

# Optional: use the Anthropic API directly instead of OpenRouter (also update
# provider + api_key_env in src/config_ai.py)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Polygon.io for higher-quality ticker-filtered news, real-time VWAP,
# and unusual options flow. Free key at polygon.io/dashboard/signup. The
# screener runs identically without it.
# POLYGON_API_KEY=your_polygon_key_here

# Optional: contact address sent to SEC EDGAR (insider-buys, Form 10/13D, XBRL).
# The SEC asks every client to identify itself; unset, requests may be throttled or refused.
# SEC_EDGAR_CONTACT=you@example.com

# Free key for earnings calendars and indicated dividend yields (finnhub.io/register)
# FINNHUB_API_KEY=your_finnhub_api_key_here

# Free key for FRED / ALFRED point-in-time macro vintages (fredaccount.stlouisfed.org/apikeys)
# FRED_API_KEY=your_fred_api_key_here

# Alpaca paper/market-data keys (free tier: 1m/5m SIP bars, indicative options, Benzinga news, calendar)
# APCA_API_KEY_ID=your_alpaca_key_id
# APCA_API_SECRET_KEY=your_alpaca_secret_key

# Databento API key (pay-as-you-go institutional OPRA history; $125 free signup credit)
# DATABENTO_API_KEY=db-your_databento_key_here

# Free key for historical options backfill (python -m src.av_options --probe)
ALPHAVANTAGE_API_KEY=get_free_key_at_alphavantage.co/support

# Discord / Telegram bots (see README -> "API + Discord & Telegram Bots")
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_server_id_for_instant_sync
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
